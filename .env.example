# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord User ID (for owner-only commands)
OWNER_ID=your_discord_user_id

# Guild/Server ID (optional - for faster slash command registration)
GUILD_ID=your_server_id

# Working directory for Claude Code sessions (default: user home)
WORK_DIR=/mnt/c/github

# Claude Code CLI path (if not in PATH)
CLAUDE_CLI_PATH=claude

# ===== Multi-PC Instance Configuration =====

# Unique identifier for this PC instance (default: hostname)
# Use different values for each PC running the bot
INSTANCE_ID=bld

# Human-friendly name for this instance (default: INSTANCE_ID)
INSTANCE_NAME=BLD

# Emoji to identify this instance in Discord (default: 🖥️)
INSTANCE_EMOJI=🖥️

# Is this the PRIMARY instance? (default: false)
# The primary instance handles messages when no specific instance is targeted
# Only ONE instance should have this set to true
INSTANCE_PRIMARY=true

# ===== Task Queue Configuration =====

# Maximum concurrent background tasks (default: 3)
MAX_CONCURRENT_TASKS=3

# Task timeout in milliseconds (default: 600000 = 10 minutes)
TASK_TIMEOUT_MS=600000

# ===== Multi-Instance Routing =====
# 
# How instance claiming works:
# 1. EXPLICIT TARGETING - User mentions instance by name:
#    - "@BLD do this" or "BLD: do this" -> goes to BLD
#    - "@Laptop check that" or "hey laptop" -> goes to Laptop
#
# 2. CHANNEL CONTEXT - Who responded last in this channel:
#    - If BLD answered recently, BLD continues handling
#    - Threads inherit from their creator instance
#
# 3. PRIMARY FALLBACK - When no preference:
#    - The primary instance (INSTANCE_PRIMARY=true) handles it
#    - If primary is offline, others use reaction-based claiming
