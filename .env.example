# Discord Bot Token - Get from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord User ID (for owner-only commands)
OWNER_ID=your_discord_user_id

# Guild/Server ID (optional - for faster slash command registration)
GUILD_ID=your_server_id

# Working directory for Claude Code sessions (default: user home)
WORK_DIR=/mnt/c/github

# Claude Code CLI path (if not in PATH)
CLAUDE_CLI_PATH=claude

# ===== Multi-PC Instance Configuration =====

# Unique identifier for this PC instance (default: hostname)
# Use different values for each PC running the bot
INSTANCE_ID=

# Human-friendly name for this instance (default: INSTANCE_ID)
INSTANCE_NAME=MyPC

# Emoji to identify this instance in Discord (default: 🖥️)
INSTANCE_EMOJI=🖥️

# ===== Task Queue Configuration =====

# Maximum concurrent background tasks (default: 3)
MAX_CONCURRENT_TASKS=3

# Task timeout in milliseconds (default: 600000 = 10 minutes)
TASK_TIMEOUT_MS=600000
